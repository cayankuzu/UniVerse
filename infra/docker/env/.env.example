# Only non-secret, synthetic validation controls belong here.
UNIVERSE_DOCKER_TAG=local
GIT_SHA=unknown

# Destructive cleanup remains opt-in. Set exactly YES only for `npm run docker:clean`.
DOCKER_CLEAN_CONFIRM=NO

# Keeps the canonical Supabase CLI stack running after docker:test when true.
DOCKER_KEEP_SUPABASE_RUNNING=false
